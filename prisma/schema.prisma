generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
  ORGANIZER
  SUBADMIN
}

enum UserTypeName {
  STUDENT
  GRADUATE
  FACULTY_MEMBER
  GUARDIAN
  EMPLOYEE
  ORGANIZER
  ADMIN
  SUBADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClubMembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CouncilApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TrainingStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

// ─────────────────────────────────────────
// USER
// ─────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  gender    Gender?
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  college         College?  @relation(fields: [collegeId], references: [id])
  collegeId       String?

  userTypes       UserTypeAssignment[]
  clubMemberships ClubMembership[]
  councilApplications CouncilApplication[]
  activityApplications ActivityApplication[]
  scholarshipApplications ScholarshipApplication[]
  volunteerApplications VolunteerApplication[]
  serviceApplications ServiceApplications[]
  trainingEnrollments TrainingEnrollment[]
}

// ─────────────────────────────────────────
// USER TYPE  (Many-to-Many)
// ─────────────────────────────────────────

model UserType {
  id        String       @id @default(cuid())
  name      UserTypeName @unique
  users     UserTypeAssignment[]
}

model UserTypeAssignment {
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  userType   UserType @relation(fields: [userTypeId], references: [id])
  userTypeId String
  assignedAt DateTime @default(now())

  @@id([userId, userTypeId])
}

// ─────────────────────────────────────────
// COLLEGE
// ─────────────────────────────────────────

model College {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

// ─────────────────────────────────────────
// SPORTS CLUB
// ─────────────────────────────────────────

model SportsClub {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  logoUrl     String?

  // المسؤولون الثابتون
  presidentId       String?
  boardSupervisorId String?   // مشرف من هيئة التدريس
  adminSupervisorId String?   // مشرف إداري من إدارة الحياة الجامعية

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships         ClubMembership[]
  councilApplications CouncilApplication[]
  activities          ClubActivity[]
}

model ClubMembership {
  id        String               @id @default(cuid())
  user      User                 @relation(fields: [userId], references: [id])
  userId    String
  club      SportsClub           @relation(fields: [clubId], references: [id])
  clubId    String
  status    ClubMembershipStatus @default(PENDING)
  joinedAt  DateTime?
  createdAt DateTime             @default(now())

  activityParticipations ClubActivityParticipation[]

  @@unique([userId, clubId])
}

model CouncilApplication {
  id        String                   @id @default(cuid())
  user      User                     @relation(fields: [userId], references: [id])
  userId    String
  club      SportsClub               @relation(fields: [clubId], references: [id])
  clubId    String
  status    CouncilApplicationStatus @default(PENDING)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@unique([userId, clubId])
}

model ClubActivity {
  id          String     @id @default(cuid())
  club        SportsClub @relation(fields: [clubId], references: [id])
  clubId      String
  title       String
  description String?
  points      Int        @default(0)
  date        DateTime?
  createdAt   DateTime   @default(now())

  participations ClubActivityParticipation[]
}

model ClubActivityParticipation {
  id           String         @id @default(cuid())
  membership   ClubMembership @relation(fields: [membershipId], references: [id])
  membershipId String
  activity     ClubActivity   @relation(fields: [activityId], references: [id])
  activityId   String
  pointsEarned Int            @default(0)
  createdAt    DateTime       @default(now())

  @@unique([membershipId, activityId])
}

// ─────────────────────────────────────────
// PARTNER COMPANY
// ─────────────────────────────────────────

model PartnerCompany {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  logoUrl     String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────
// SCHOLARSHIP
// ─────────────────────────────────────────

model Scholarship {
  id          String   @id @default(cuid())
  title       String
  description String?
  amount      Float?
  deadline    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications ScholarshipApplication[]
}

model ScholarshipApplication {
  id            String            @id @default(cuid())
  user          User              @relation(fields: [userId], references: [id])
  userId        String
  scholarship   Scholarship       @relation(fields: [scholarshipId], references: [id])
  scholarshipId String
  status        ApplicationStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([userId, scholarshipId])
}

// ─────────────────────────────────────────
// FINANCIAL SOLUTION
// ─────────────────────────────────────────

model FinancialSolution {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────
// STUDENT SERVICE
// ─────────────────────────────────────────

model StudentService {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications ServiceApplications[]
}

model ServiceApplications {
  id        String            @id @default(cuid())
  user      User              @relation(fields: [userId], references: [id])
  userId    String
  service   StudentService    @relation(fields: [serviceId], references: [id])
  serviceId String
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, serviceId])
}

// ─────────────────────────────────────────
// STUDENT ACTIVITY
// ─────────────────────────────────────────

model StudentActivity {
  id          String    @id @default(cuid())
  title       String
  description String?
  date        DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applications ActivityApplication[]
}

model ActivityApplication {
  id         String            @id @default(cuid())
  user       User              @relation(fields: [userId], references: [id])
  userId     String
  activity   StudentActivity   @relation(fields: [activityId], references: [id])
  activityId String
  status     ApplicationStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([userId, activityId])
}

// ─────────────────────────────────────────
// VOLUNTEER OPPORTUNITY
// ─────────────────────────────────────────

model VolunteerOpportunity {
  id          String    @id @default(cuid())
  title       String
  description String?
  date        DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applications VolunteerApplication[]
}

model VolunteerApplication {
  id            String               @id @default(cuid())
  user          User                 @relation(fields: [userId], references: [id])
  userId        String
  opportunity   VolunteerOpportunity @relation(fields: [opportunityId], references: [id])
  opportunityId String
  status        ApplicationStatus    @default(PENDING)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([userId, opportunityId])
}

// ─────────────────────────────────────────
// TRAINING
// ─────────────────────────────────────────

model Training {
  id          String         @id @default(cuid())
  title       String
  description String?
  instructor  String?
  category    String?
  capacity    Int?
  startDate   DateTime?
  endDate     DateTime?
  status      TrainingStatus @default(UPCOMING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  enrollments TrainingEnrollment[]
}

model TrainingEnrollment {
  id         String           @id @default(cuid())
  user       User             @relation(fields: [userId], references: [id])
  userId     String
  training   Training         @relation(fields: [trainingId], references: [id])
  trainingId String
  status     EnrollmentStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([userId, trainingId])
}
